# ── Секреты: НИКОГДА не коммитим (R1) ─────────────────────────────
# Реальный конфиг с spreadsheet_id и путями — только локально.
config.yaml
# Любые JSON — почти всегда это ключ сервисного аккаунта Google.
*.json
sa-key.json
google-sa.json
.env
.env.*

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
build/
dist/

# ── Прочее ────────────────────────────────────────────────────────
*.log
.DS_Store
# Временные файлы атомарной записи фида (R5), на случай падения между
# записью tmp и os.replace.
feeds/*.tmp

# Кэш пайплайна (спеки/состояние) коммитится намеренно — идемпотентность
# должна переживать эфемерные прогоны GitHub Actions. Игнорируем только tmp.
data/**/*.tmp
data/**/*.json.tmp

# ── Серверное развёртывание: секреты и реальный конфиг вне git ─────
deploy/.env
deploy/config.yaml
deploy/secrets/*
!deploy/secrets/.gitkeep

# ── PHP-генератор фида Авто.ру (feed.php) ─────────────────────────
# Реальный конфиг с кредами БД — только на сервере, не в git.
feed.config.php
# Рантайм-артефакты: статический кэш фида и лог (пишутся скриптом).
# Привязка к корню, чтобы не задеть feeds/autoru.xml Python-пайплайна.
/autoru.xml
/autoru.xml.tmp
/feed.log
