# Переменные окружения сервера. Скопируйте в .env и заполните: cp .env.example .env
# .env лежит только на сервере и в git не попадает.

# Домен для HTTPS-раздачи фидов (A-запись → IP сервера).
DOMAIN=feeds.example.ru

# Время ежедневного прогона (UTC, HH:MM). 06:00 UTC = 09:00 МСК.
RUN_AT=06:00

# ── Auto.ru API: выгрузка всех объявлений кабинета ────────────────
# Ключ из кабинета, можно прямо с префиксом «Vertis ».
AUTORU_API_KEY=
# Вход в кабинет (почта/телефон и пароль) — либо готовая сессия.
AUTORU_LOGIN=
AUTORU_PASSWORD=
AUTORU_SESSION_ID=
# Категория: all | cars | moto | trucks
AUTORU_CATEGORY=all
# Дополнительно выгружать отдельный файл только с неактивными (1 — да, 0 — нет).
AUTORU_EXPORT_INACTIVE=1
# Город для фида Drom, если в объявлении Auto.ru он не указан.
DROM_CITY=

# ── Пайплайн обогащения ───────────────────────────────────────────
ANTHROPIC_API_KEY=
IMGBB_API_KEY=
PIXFLOW_API_KEY=
# Путь к JSON-ключу Google внутри контейнера (файл кладётся в deploy/secrets/).
GOOGLE_SA_JSON_FILE=/app/secrets/google-sa.json
