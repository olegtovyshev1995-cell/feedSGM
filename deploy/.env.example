# ── Окружение для развёртывания на своём сервере ───────────────────
# Скопируйте этот файл в `.env` (`cp .env.example .env`) и заполните
# реальными значениями. Сам `.env` в git НЕ попадает (заблокирован
# .gitignore) — это серверный аналог GitHub Secrets.

# Домен, по которому Caddy будет раздавать фиды и выпустит HTTPS-сертификат.
# A-запись домена должна указывать на IP этого сервера, порты 80/443 открыты.
DOMAIN=feeds.example.com

# Время ежедневного прогона пайплайна (UTC, формат HH:MM). По умолчанию 06:00.
RUN_AT=06:00

# ── Ключи (секреты) ───────────────────────────────────────────────
# Ключ Claude API — нужен стадии enrich (обогащение спеки агентом).
ANTHROPIC_API_KEY=

# Ключ imgbb — нужен стадии host_photos (хостинг фото).
IMGBB_API_KEY=

# Ключ pixflow — понадобится позже для уникализации фото (слот C4).
# Можно оставить пустым, пока стадия не используется.
PIXFLOW_API_KEY=

# ── Google Service Account ────────────────────────────────────────
# JSON-ключ сервисного аккаунта кладётся ФАЙЛОМ в secrets/google-sa.json
# (том ./secrets монтируется в контейнер как /app/secrets, только чтение).
# run_pipeline.sh сам прочитает файл в переменную GOOGLE_SA_JSON.
# Не забудьте выдать сервисному аккаунту доступ Viewer к вашей Google-таблице.
GOOGLE_SA_JSON_FILE=/app/secrets/google-sa.json
